            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>&lt;replaced-sha1&gt;</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>&lt;замінено-sha1&gt;</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>&lt;remote-name&gt;</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>&lt;віддалене ім'я&gt;</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>dereference</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>розгортання посилання</term></tig></langSet>
                <note from="translator">У Git розгортання посилання — це процес перетворення посилання (наприклад, імені гілки або тегу) у конкретний об’єкт, на який воно вказує, шляхом проходження ланцюжка посилань доти, доки не буде досягнуто несимволічного об’єкта (зазвичай коміту). Це є необхідним для команд, які мають працювати з фактичними даними, а не з символічними іменами.</note>
            </termEntry>
            <termEntry id="noun">
                <langSet xml:lang="en"><tig><term>clone</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>клон</term></tig></langSet>
            </termEntry>
            <termEntry id="verb">
                <langSet xml:lang="en"><tig><term>clone</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>клон</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>script</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>скрипт</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>patch</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>латка</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>note</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>нотатка</term></tig></langSet>
            </termEntry>
        </body>
    </text>
</martif>
