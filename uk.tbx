                <langSet xml:lang="uk"><tig><term>&lt;гілка&gt;</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>&lt;key-id&gt;</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>&lt;ідентифікатор-ключа&gt;</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>&lt;refspec&gt;</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>&lt;специфікація посилання&gt;</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>&lt;group&gt;</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>&lt;група&gt;</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>&lt;git-upload-archive&gt;</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>&lt;git-надсилання-архіву&gt;</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>&lt;version&gt;</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>&lt;версія&gt;</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>&lt;parent-number&gt;</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>&lt;батьківський номер&gt;</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>&lt;config-file&gt;</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>&lt;конфігураційний файл&gt;</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>&lt;ref&gt;</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>&lt;посилання&gt;</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>&lt;object&gt;</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>&lt;об'єкт&gt;</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>&lt;time&gt;</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>&lt;час&gt;</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>&lt;dir&gt;</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>&lt;dir&gt;</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>&lt;message-id&gt;</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>&lt;ідентифікатор повідомлення&gt;</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>&lt;subject-prefix&gt;</term></tig></langSet>
