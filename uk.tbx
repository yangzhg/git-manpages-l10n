<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE martif PUBLIC "ISO 12200:1999A//DTD MARTIF core (DXFcdV04)//EN" "TBXcdv04.dtd">
<martif type="TBX" xml:lang="en">
    <martifHeader>
        <fileDesc>
            <sourceDesc>
                <p>Translate Toolkit</p>
            </sourceDesc>
        </fileDesc>
    </martifHeader>
    <text>
        <body>
            <termEntry>
                <langSet xml:lang="en"><tig><term>bare clone</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>голий клон</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>SSH:256</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>SSH:256</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>checkout</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>перехід на іншу гілку</term></tig></langSet>
                <note from="translator">Команда git checkout використовується переважно для переходу між гілками та відновлення файлів робочого дерева до попереднього стану. У новіших версіях Git (2.23+) її функції концептуально розділено на git switch (для переходу між гілками) та git restore (для роботи з файлами), хоча git checkout залишається повністю функціональною.</note>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>3-way merge</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>3-стороннє злиття</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>annotated tag</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>анотований тег</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>bare repo</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>голий звіт</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>bare repository</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>голий репозиторій</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>amend</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>виправити</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>blame</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>автори змін</term></tig></langSet>
                <note from="translator">Команда git blame — це функція Git, яка використовується для перегляду інформації про те, хто востаннє вносив зміни до кожного рядка файлу та коли ці зміни були зроблені. Вона допомагає розробникам зрозуміти історію та контекст змін у коді, що є корисним для налагодження або з’ясування причин наявності певного фрагмента коду.</note>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>changeset</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>набір змін</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>clone (noun)</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>клонування</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>clone (verb)</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>клонувати</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>bisect</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>розділити навпіл</term></tig></langSet>
                <note from="translator">Бісекція — це процес поділу об’єкта, кута або набору даних на дві рівні, конгруентні або приблизно рівні частини, який зазвичай використовується в геометрії, математиці та розробці програмного забезпечення для ефективного виділення певної точки. Див. https://uk.wikipedia.org/wiki/Бісекція</note>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>-p</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>-p</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>check out</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>перевірити</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>commit-ish</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>вказівник коміту</term></tig></langSet>
                <note from="translator">«Commit-ish» (або «committish») — це термін, що використовується в Git для позначення будь-якого посилання чи ідентифікатора, який у кінцевому підсумку вказує на обʼєкт коміту або може бути рекурсивно розібраний до нього.</note>
            </termEntry>
